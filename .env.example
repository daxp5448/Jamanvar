# ------------------------------------------------------------------------------
# Jamanvar production environment — copy to `.env` on the server.
#   cp .env.example .env && nano .env
#
# This site is a stateless marketing front-end: no database, no secrets, no API
# keys. These values only control the public URL and the host port binding.
# ------------------------------------------------------------------------------

# Public canonical URL. Baked into metadata, robots.txt and sitemap.xml at build
# time, so change it and re-run `make deploy` (not just `make restart`).
SITE_URL=https://jamanvar.kelviontech.in

# Host port the container publishes on. Reached by the shared nginx container
# via the docker0 bridge gateway (172.17.0.1), the same way it already reaches
# restaurant.kelviontech.in on 3001 — see docker-compose.yml for why this is
# 0.0.0.0 and not 127.0.0.1.
HOST_PORT=3002

# Path to the KelvionTech repo on this VM — where the shared nginx container's
# config (nginx/conf.d/) and certbot service live. Used by `make nginx-install`
# and `make ssl`.
KELVIONTECH_DIR=/home/ubuntu/KelvionTech
