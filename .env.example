# ------------------------------------------------------------------------------
# Jamanvar production environment — copy to `.env` on the server.
#   cp .env.example .env && nano .env
#
# This site is a stateless marketing front-end: no database, no secrets, no API
# keys. These values only control the public URL and the host port binding.
# ------------------------------------------------------------------------------

# Public canonical URL. Baked into metadata, robots.txt and sitemap.xml at build
# time, so change it and re-run `make deploy` (not just `make restart`).
SITE_URL=https://jamanvar.kelviontech.in

# Host port the container publishes on 127.0.0.1.
#   3000 = kelviontech.in, 3001 = restaurent.kelviontech.in, 3002 = this site.
HOST_PORT=3002

# ONLY for the containerised-nginx setup (docker-compose.shared-nginx.yml).
# Name of the existing KelvionTech Docker network — check with:
#   docker network ls | grep -i kelvion
# KELVION_NETWORK=kelviontech_default
