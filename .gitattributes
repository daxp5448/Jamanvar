# Normalise text files to LF in the repository.
* text=auto eol=lf

# These MUST be LF — CRLF breaks them on the Linux server:
#   shell scripts  -> "bad interpreter: /usr/bin/env bash^M"
#   Dockerfile     -> CRLF leaks into RUN commands
#   Makefile       -> recipe lines fail
*.sh        text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
*.yml       text eol=lf
*.conf      text eol=lf
.env.example text eol=lf

# Binary assets — never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.woff binary
*.woff2 binary
